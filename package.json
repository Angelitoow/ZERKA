{
  "name": "zerka-frontend-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix zerka run dev",
    "build": "npm --prefix zerka run build",
    "start": "npm --prefix zerka run start",
    "lint": "npm --prefix zerka run lint",
    "db:pull": "npm --prefix zerka exec -- prisma db pull",
